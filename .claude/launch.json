{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Mockup (Static)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "mockup", "-p", "5500", "--no-clipboard"],
      "port": 5500
    },
    {
      "name": "Backend (FastAPI)",
      "runtimeExecutable": "uvicorn",
      "runtimeArgs": ["main:app", "--reload", "--port", "8000"],
      "cwd": "backend",
      "port": 8000
    },
    {
      "name": "Frontend (Next.js)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 3000
    }
  ]
}
